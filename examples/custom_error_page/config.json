[
	{
		"name": "custom error page",
		"listen": "0.0.0.0:8080",
		"locations": [
			{
				"uri": "/",
				"path": "./examples/custom_error_page/"
			}
		],
		"document_index": "/index.html",
		"allowed_methods": ["GET"],
		"error_pages": [
			{
				"error_code": 404,
				"uri": "/error/404.html"
			}
		]
	}
]